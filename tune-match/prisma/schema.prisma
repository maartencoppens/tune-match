generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Genre {
  id              String             @id @default(cuid())
  name            String             @unique
  description     String?
  artistReference String?
  visualTheme     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  scores          AnswerGenreScore[]
  resultSessions  QuizSession[]      @relation("SessionResultGenre")
}

model Question {
  id           String         @id @default(cuid())
  text         String
  orderIndex   Int            @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  answerOptions AnswerOption[]
  sessionAnswers SessionAnswer[]
}

model AnswerOption {
  id           String             @id @default(cuid())
  questionId   String
  label        String
  orderIndex   Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  question      Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  genreScores   AnswerGenreScore[]
  sessionAnswers SessionAnswer[]

  @@unique([questionId, orderIndex])
}

model AnswerGenreScore {
  id             String       @id @default(cuid())
  answerOptionId String
  genreId        String
  score          Int
  createdAt      DateTime     @default(now())

  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  genre          Genre        @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([answerOptionId, genreId])
}

model QuizSession {
  id             String          @id @default(cuid())
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  status         SessionStatus   @default(IN_PROGRESS)

  // eventueel nuttig voor installatie-context
  installationId String?
  participantTag String?         // bv. anonieme code of device id
  photoUrl       String?
  qrCodeUrl      String?

  // eindresultaat
  resultGenreId  String?
  resultGenre    Genre?          @relation("SessionResultGenre", fields: [resultGenreId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  answers        SessionAnswer[]
}

model SessionAnswer {
  id             String       @id @default(cuid())
  sessionId      String
  questionId     String
  answerOptionId String
  answeredAt     DateTime     @default(now())

  session        QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}